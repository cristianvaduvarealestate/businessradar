{
  "name": "radar-business-romania",
  "version": "1.0.0",
  "description": "Autonomous National Business Intelligence, Company Discovery & Insurance Lead Generation Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && node scripts/patch-worker-scheduled.js",
    "preview": "opennextjs-cloudflare build && node scripts/patch-worker-scheduled.js && opennextjs-cloudflare preview",
    "deploy:worker": "node scripts/patch-worker-scheduled.js && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "next lint",
    "db:init": "node scripts/init-db.js",
    "ingest:onrc": "node scripts/sync-onrc.js",
    "ingest:watchdog": "node scripts/run-watchdog.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "wrangler": "^4.86.0"
  }
