{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "businessradar",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "AUTHORIZED_ADMIN_EMAILS": "myremaxclubcristianv@gmail.com",
    "CANONICAL_HOSTNAME": "businessradar.cristianvaduva.com"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "businessradar-db",
      "database_id": "58b90910-e6d0-4c6b-8103-6d6cc62615ff"
    }
  ]
}
